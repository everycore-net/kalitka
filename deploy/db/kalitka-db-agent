#!/usr/bin/env bash
# kalitka-db-agent — the reference database connector.
#
# It runs NEXT TO the database and turns an approved kalitka grant into real,
# time-boxed access — then removes it when the grant ends, INCLUDING after a crash:
#
#   kalitka Core  --signed grant-->  kalitka-db-agent  -->  database
#
# Core is the control plane: it decides who / to what / with which profile / under
# what conditions, and records it. It NEVER holds a DB-admin credential and never
# issues raw SQL — a grant carries only a server-side PROFILE (sql-readonly, sql-writer,
# sql-order-correction, …) that the local driver maps to a predefined role. *kalitka
# brokers authority, not database credentials.*
#
# This is the engine-agnostic entrypoint: it sources the shared lifecycle
# (kalitka-db-lib) and one engine driver (drivers/<engine>), so a second engine reuses
# the whole lifecycle — provisioning, the signed protocol, and crash recovery — and only
# adds its own SQL. DB_ENGINE selects the driver (default: sqlserver).
#
# Config: $KALITKA_DB_CONF (default /etc/kalitka/db-agent.conf) + the shared kalitka-agent
# config for KALITKA_URL and the agent credential. See kalitka-db-agent.conf.example.
#
# Usage:
#   kalitka-db-agent access --database DB --profile P --user U \
#       [--mode ephemeral|grant] [--login EXISTING_LOGIN] [--ttl-min N] [--max-uses N]
#   kalitka-db-agent action --database DB --profile P --user U [--param NAME=VALUE]...
#   kalitka-db-agent reconcile      # crash recovery: revoke orphaned access (cron/timer)
#
# `access` provisions interactive, time-boxed access (deprovisioned on a graceful exit);
# `action` hands out NO login — it runs one DBA-vetted stored procedure and counts it as
# exactly one use; `reconcile` cleans up what an ungraceful death left behind (timer + boot).
set -euo pipefail

DB_CONF="${KALITKA_DB_CONF:-/etc/kalitka/db-agent.conf}"
[ -r "$DB_CONF" ] && . "$DB_CONF"
AGENT_CONF="${KALITKA_CONF:-/etc/kalitka-approve.conf}"
[ -r "$AGENT_CONF" ] && . "$AGENT_CONF"

DB_ENGINE="${DB_ENGINE:-sqlserver}"

# Locate the lib and the driver: explicit overrides, else next to this script, else the
# system lib dir.
_self_dir="$(cd "$(dirname "$0")" && pwd)"
LIB="${KALITKA_DB_LIB:-}"
if [ -z "$LIB" ]; then
  for c in "$_self_dir/kalitka-db-lib" /usr/local/lib/kalitka/kalitka-db-lib; do
    [ -r "$c" ] && { LIB="$c"; break; }
  done
fi
DRIVER_DIR="${KALITKA_DB_DRIVER_DIR:-}"
if [ -z "$DRIVER_DIR" ]; then
  for c in "$_self_dir/drivers" /usr/local/lib/kalitka/drivers; do
    [ -d "$c" ] && { DRIVER_DIR="$c"; break; }
  done
fi

[ -n "$LIB" ] && [ -r "$LIB" ] || { echo "kalitka-db-agent: cannot find kalitka-db-lib (set KALITKA_DB_LIB)" >&2; exit 1; }
DRIVER="$DRIVER_DIR/$DB_ENGINE"
[ -r "$DRIVER" ] || { echo "kalitka-db-agent: no driver for DB_ENGINE='$DB_ENGINE' at $DRIVER" >&2; exit 1; }

command -v openssl >/dev/null 2>&1 || { echo "kalitka-db-agent: missing dependency: openssl" >&2; exit 1; }
command -v curl    >/dev/null 2>&1 || { echo "kalitka-db-agent: missing dependency: curl" >&2; exit 1; }

# shellcheck source=/dev/null
. "$DRIVER"
# shellcheck source=/dev/null
. "$LIB"

cmd="${1:-}"; shift || true
case "$cmd" in
  access)    db_access "$@" ;;
  action)    db_action "$@" ;;
  reconcile) db_reconcile ;;
  ""|-h|--help|help) sed -n '2,31p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "kalitka-db-agent: unknown command: $cmd (try --help)" >&2; exit 1 ;;
esac
