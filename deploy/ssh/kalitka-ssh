#!/usr/bin/env bash
# kalitka-ssh — JIT SSH access with short-lived OpenSSH certificates.
#
# The SSH analogue of the database connector, same architecture:
#
#   kalitka Core  --signed grant-->  kalitka-ssh (holds the CA)  -->  target host
#
# Core is the control plane: it decides who / to what / under which policy, and records
# it. It NEVER holds the SSH CA key. On a host you already reach (a bastion), `connect`
# mints an ephemeral keypair, raises an access request, waits for a human's approval, and
# on approval signs a **short-lived** user certificate — principals from the request, TTL
# from the grant's `expires_at` (which already reflects any access policy). You then land
# on the target with a cert that self-expires; there is nothing to revoke and nothing to
# leak — the certificate IS the time-boxed authority. *kalitka brokers authority, not
# credentials.*
#
# Target hosts trust the CA's public half:
#   # /etc/ssh/sshd_config on every target
#   TrustedUserCAKeys /etc/ssh/kalitka_ca.pub
# and the login name must be an allowed principal (it is, by default: the cert is issued
# for the requested --user).
#
# HARDENED SIGNER BOUNDARY (0.28). The CA private key is a serious trust boundary: anyone
# who can read it can mint certificates outside kalitka. So the CA-touching step (redeem +
# sign) is split out as the `sign-redeem` subcommand, meant to run as a dedicated CA owner
# (kalitka-ca, key mode 0600) behind a privilege boundary. Set:
#   KALITKA_SSH_SIGN_CMD="sudo -n -u kalitka-ca /usr/local/bin/kalitka-ssh"
# and `connect`/`sign` delegate signing to it — the public key crosses on stdin, the cert
# comes back on stdout, so the calling user never reads the CA key and cannot influence the
# cert's contents (principal/command/source/expiry all come from Core's redeem). Leaving
# KALITKA_SSH_SIGN_CMD unset signs in-process (simple/dev; the runner can read the CA key).
#
# All gate I/O goes through kalitka-agent (Ed25519-signed). Enrol this host as a kalitka
# agent with capability `ssh` and the resources it may reach (e.g. ssh:*), exactly like
# the PAM hook — see README.md. Config: $KALITKA_SSH_CONF (default /etc/kalitka/ssh-ca.conf)
# plus the shared /etc/kalitka-approve.conf.
#
# Subcommands:
#   keygen                    create the CA keypair if absent, print its public key (as kalitka-ca)
#   ca-pubkey                 print the CA public key (for TrustedUserCAKeys on hosts)
#   connect --host H [--user U] [--command 'CMD'] [--source-address CIDR]   JIT, then exec ssh
#   sign --host H --user U --pubkey FILE [--command 'CMD'] [--source-address CIDR]   sign only
#   sign-redeem --grant G     privileged: redeem + sign a pubkey from stdin (run as kalitka-ca)
#
# --command requests a force-command certificate: the human approves that exact command
# and the issued cert can run ONLY it (the SSH analogue of a pre-approved stored proc).
# --source-address pins the cert to an approved source CIDR (usable only from there). A
# policy can require a command or a source address, or restrict which logins are allowed.
# Both are bound to the approval: the signer applies only what Core returns on redeem.
#
# The certificate principal is ALWAYS the identity Core approved (the request's --user),
# returned on redeem — never a separate caller argument, so an approved request for one
# login can never be turned into a certificate for another.
set -euo pipefail

SSH_CONF="${KALITKA_SSH_CONF:-/etc/kalitka/ssh-ca.conf}"
[ -r "$SSH_CONF" ] && . "$SSH_CONF"
AGENT_CONF="${KALITKA_CONF:-/etc/kalitka-approve.conf}"
[ -r "$AGENT_CONF" ] && . "$AGENT_CONF"

AGENT="${KALITKA_AGENT_BIN:-/usr/local/bin/kalitka-agent}"
CA_KEY="${KALITKA_SSH_CA_KEY:-/etc/kalitka/ssh_ca}"
# Conservative certificate options by default; override in the conf if you need more.
CERT_OPTS="${KALITKA_SSH_CERT_OPTS:--O clear -O permit-pty -O no-agent-forwarding -O no-port-forwarding -O no-x11-forwarding}"
# Hardened signer boundary (0.28): when set, the CA-touching step (redeem + sign) is
# delegated to a privileged helper so the calling user never reads the CA key — e.g.
#   KALITKA_SSH_SIGN_CMD="sudo -n -u kalitka-ca /usr/local/bin/kalitka-ssh"
# Unset = sign in-process (simple/dev; the runner can read the CA key — NOT hardened).
SIGN_CMD="${KALITKA_SSH_SIGN_CMD:-}"

die() { echo "kalitka-ssh: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }
field() { sed -n 's/.*"'"$1"'":"\([^"]*\)".*/\1/p'; }
nfield() { sed -n 's/.*"'"$1"'":\([0-9]\{1,\}\).*/\1/p'; }
arg() { local want="$1"; shift; while [ $# -gt 0 ]; do case "$1" in "--$want") printf '%s' "${2:-}"; return 0 ;; esac; shift; done; }

need "$AGENT"; need ssh-keygen

keygen() {
  if [ ! -f "$CA_KEY" ]; then
    mkdir -p "$(dirname "$CA_KEY")"
    ( umask 077; ssh-keygen -q -t ed25519 -f "$CA_KEY" -N '' -C "kalitka-ssh-ca" )
  fi
  cat "$CA_KEY.pub"
}

# Raise -> approve for ssh:<host>; echoes the one-time GRANT token. This is the
# UNPRIVILEGED half: it needs no CA key. Redemption and signing happen behind the
# (optionally privileged) signer boundary in _redeem_and_sign.
_raise_wait() {
  local host="$1" user="$2" command="${3:-}" source="${4:-}"
  local resp id state
  local -a req=(request --host "$host" --user "$user")
  [ -n "$command" ] && req+=(--command "$command")
  [ -n "$source" ] && req+=(--source-address "$source")
  resp="$("$AGENT" "${req[@]}")" || die "gate unreachable or request refused"
  id="$(printf '%s' "$resp" | field id)"; state="$(printf '%s' "$resp" | field state)"
  [ -n "$id" ] || die "no request id (state=$state)"
  echo "kalitka-ssh: request $id for ssh:$host ($user) — waiting for approval..." >&2
  local i=0 st grant=""
  while [ "$i" -lt 100 ]; do
    sleep 3; i=$((i + 1))
    st="$("$AGENT" poll --id "$id" 2>/dev/null)" || continue
    case "$(printf '%s' "$st" | field state)" in
      approved) grant="$(printf '%s' "$st" | field grant)"; break ;;
      denied) die "denied" ;;
      gone)   die "request expired" ;;
    esac
  done
  [ -n "$grant" ] || die "timed out waiting for approval"
  printf '%s\n' "$grant"
}

# The PRIVILEGED half: redeem the grant and sign a certificate. Reads the CA key, so it
# runs as the CA owner (kalitka-ca) when a signer boundary is configured, or in-process
# otherwise. It takes only the grant and the public key to sign — the principal,
# force-command, source-address and expiry all come from Core's redeem, never the caller,
# so an operator can neither forge the cert's contents nor read the CA key. Reads the
# public key from $1 (path) or, if "-", from stdin (so it crosses a sudo boundary without
# needing cross-user file access). Echoes "SID" then the certificate line.
_redeem_and_sign() { # GRANT PUBKEY_PATH|-
  local grant="$1" pubsrc="$2"
  local red sid exp subj cmd src
  red="$("$AGENT" redeem --grant "$grant" --agent "$(hostname -s 2>/dev/null || hostname)")" || die "grant redemption failed"
  sid="$(printf '%s' "$red" | field session_id)"
  [ -n "$sid" ] || die "grant not redeemable (already used or expired)"
  exp="$(printf '%s' "$red" | nfield expires_at)"
  subj="$(printf '%s' "$red" | field subject)"
  [ -n "$subj" ] || die "redeem returned no approved principal — refusing to sign"
  cmd="$(printf '%s' "$red" | field command)"          # approved force-command (may be empty)
  src="$(printf '%s' "$red" | field source_address)"   # approved source-address (may be empty)

  local d; d="$(mktemp -d "${TMPDIR:-/tmp}/kalitka-sign.XXXXXX")"
  # trap-free cleanup: this function is short and we rm explicitly on both paths.
  if [ "$pubsrc" = "-" ]; then cat > "$d/id.pub"; else cat "$pubsrc" > "$d/id.pub"; fi
  if ! _sign "$d/id.pub" "$sid" "$exp" "$subj" "$cmd" "$src"; then rm -rf "$d"; die "signing failed"; fi
  "$AGENT" provisioned --session-id "$sid" >/dev/null 2>&1 || true
  printf '%s\n' "$sid"
  cat "$d/id-cert.pub"
  rm -rf "$d"
}

# Sign a user public key against the granted session. The principal is the Core-APPROVED
# subject only (bound to the approval, never a caller argument). The cert's end is exactly
# the grant's expiry (raw epoch, no rounding), so it cannot outlive the granted authority;
# a small negative start absorbs clock skew. Key id carries the session id, so sshd's auth
# log ties straight back to the kalitka audit trail.
_sign() { # PUBKEY_FILE SID EXPIRES PRINCIPAL [COMMAND] [SOURCE] -> writes <base>-cert.pub
  local pub="$1" sid="$2" exp="$3" principal="$4" command="${5:-}" source="${6:-}"
  [ -r "$CA_KEY" ] || die "no CA key at $CA_KEY (run 'kalitka-ssh keygen' as the CA host)"
  case "$principal" in ''|*[!A-Za-z0-9_.-]*) die "unsafe approved principal: '$principal'" ;; esac
  case "$source" in *[!0-9a-fA-F.:/,\ ]*) die "unsafe approved source-address: '$source'" ;; esac
  local now; now="$(date +%s)"
  [ -n "$exp" ] || die "grant has no expiry — refusing to sign"
  [ "$exp" -gt "$now" ] 2>/dev/null || die "grant already expired — refusing to issue a certificate"
  local start=$((now - 5))
  local -a opts=(-s "$CA_KEY" -I "kalitka:$sid" -n "$principal" -V "0x$(printf '%x' "$start"):0x$(printf '%x' "$exp")")
  # CERT_OPTS is a set of -O flags; deliberate word-split.
  # shellcheck disable=SC2206
  opts+=($CERT_OPTS)
  # Approved force-command / source-address (if any) applied as single, un-split args — the
  # session can then run only this command, and the cert works only from these addresses.
  [ -n "$command" ] && opts+=(-O "force-command=$command")
  [ -n "$source" ] && opts+=(-O "source-address=$source")
  ssh-keygen "${opts[@]}" "$pub" >&2
}

# Redeem + sign, across the (optional) signer boundary. In: grant + a public-key file.
# Out: "SID\n<cert-line>". Delegated: the pubkey goes over stdin and the cert comes back
# over stdout, so no cross-user file access is needed and the CA key stays with kalitka-ca.
_sign_via() { # GRANT PUBKEY_PATH
  local grant="$1" pub="$2"
  if [ -n "$SIGN_CMD" ]; then
    # shellcheck disable=SC2086
    $SIGN_CMD sign-redeem --grant "$grant" < "$pub"
  else
    _redeem_and_sign "$grant" "$pub"
  fi
}

case "${1:-}" in
  keygen) keygen ;;
  ca-pubkey) [ -r "$CA_KEY.pub" ] || die "no CA key at $CA_KEY"; cat "$CA_KEY.pub" ;;

  # Privileged step, run behind the signer boundary (e.g. sudo -u kalitka-ca): redeem the
  # grant and sign the public key read from stdin. Takes NOTHING about the cert's contents
  # from the caller — principal/command/source/expiry all come from Core's redeem.
  sign-redeem)
    shift
    grant="$(arg grant "$@")"; [ -n "$grant" ] || die "sign-redeem needs --grant"
    _redeem_and_sign "$grant" -
    ;;

  sign)
    shift
    host="$(arg host "$@")"; [ -n "$host" ] || die "sign needs --host"
    user="$(arg user "$@")"; [ -n "$user" ] || die "sign needs --user"
    pub="$(arg pubkey "$@")"; [ -r "$pub" ] || die "sign needs a readable --pubkey"
    command="$(arg command "$@")"; source="$(arg source-address "$@")"
    grant="$(_raise_wait "$host" "$user" "$command" "$source")"
    out="$(_sign_via "$grant" "$pub")"
    sid="$(printf '%s' "$out" | head -1)"
    cert="${pub%.pub}-cert.pub"
    printf '%s' "$out" | tail -n +2 > "$cert"
    echo "kalitka-ssh: issued $cert (session $sid)" >&2
    printf '%s\n' "$cert"
    ;;

  connect)
    shift
    host="$(arg host "$@")"; [ -n "$host" ] || die "connect needs --host"
    user="$(arg user "$@")"; [ -n "$user" ] || user="$(id -un)"
    command="$(arg command "$@")"; source="$(arg source-address "$@")"
    need ssh
    dir="$(mktemp -d "${TMPDIR:-/tmp}/kalitka-ssh.XXXXXX")"
    trap 'rm -rf "$dir"' EXIT INT TERM
    ssh-keygen -q -t ed25519 -f "$dir/id" -N '' -C "kalitka-jit"     # ephemeral, dies with $dir
    grant="$(_raise_wait "$host" "$user" "$command" "$source")"
    out="$(_sign_via "$grant" "$dir/id.pub")"
    sid="$(printf '%s' "$out" | head -1)"
    printf '%s' "$out" | tail -n +2 > "$dir/id-cert.pub"
    # The approved principal / restrictions are inside the signed cert — read them back
    # for the login name and to tell the operator exactly what they got.
    principal="$(ssh-keygen -L -f "$dir/id-cert.pub" | awk '/Principals:/{getline; print $1; exit}')"
    [ -n "$principal" ] || principal="$user"
    ssh-keygen -L -f "$dir/id-cert.pub" | grep -iE 'force-command|source-address' | sed 's/^ */kalitka-ssh: cert restriction: /' >&2 || true
    echo "kalitka-ssh: connecting to ${principal}@${host} with a short-lived certificate..." >&2
    # The session lives for the ssh connection. Report the true outcome: ssh's 255 is a
    # connection/auth failure, anything else is a session that actually ran (its exit code
    # is the remote command's). The caller gets ssh's real exit code. The cert self-expires,
    # so even a missed report never leaves standing access.
    rc=0; ssh -o IdentitiesOnly=yes -i "$dir/id" -o "CertificateFile=$dir/id-cert.pub" "${principal}@${host}" || rc=$?
    if [ "$rc" -eq 255 ]; then outcome="connection-failed"; else outcome="closed"; fi
    "$AGENT" session-end --session-id "$sid" --outcome "$outcome" >/dev/null 2>&1 || true
    exit "$rc"
    ;;

  ""|-h|--help|help) sed -n '2,53p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: ${1:-} (try --help)" ;;
esac
