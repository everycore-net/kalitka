#!/usr/bin/env bash
# kalitka-ssh — JIT SSH access with short-lived OpenSSH certificates.
#
# The SSH analogue of the database connector, same architecture:
#
#   kalitka Core  --signed grant-->  kalitka-ssh (holds the CA)  -->  target host
#
# Core is the control plane: it decides who / to what / under which policy, and records
# it. It NEVER holds the SSH CA key. On a host you already reach (a bastion), `connect`
# mints an ephemeral keypair, raises an access request, waits for a human's approval, and
# on approval signs a **short-lived** user certificate — principals from the request, TTL
# from the grant's `expires_at` (which already reflects any access policy). You then land
# on the target with a cert that self-expires; there is nothing to revoke and nothing to
# leak — the certificate IS the time-boxed authority. *kalitka brokers authority, not
# credentials.*
#
# The CA private key stays here; target hosts trust its public half:
#   # /etc/ssh/sshd_config on every target
#   TrustedUserCAKeys /etc/ssh/kalitka_ca.pub
# and the login name must be an allowed principal (it is, by default: the cert is issued
# for the requested --user).
#
# All gate I/O goes through kalitka-agent (Ed25519-signed). Enrol this host as a kalitka
# agent with capability `ssh` and the resources it may reach (e.g. ssh:*), exactly like
# the PAM hook — see README.md. Config: $KALITKA_SSH_CONF (default /etc/kalitka/ssh-ca.conf)
# plus the shared /etc/kalitka-approve.conf.
#
# Subcommands:
#   keygen                    create the CA keypair if absent, print its public key
#   ca-pubkey                 print the CA public key (for TrustedUserCAKeys on hosts)
#   connect --host H [--user U] [--command 'CMD']   the JIT flow, then exec ssh
#   sign --host H --user U --pubkey FILE [--command 'CMD']   sign only, print the cert path
#
# --command requests a force-command certificate: the human approves that exact command
# and the issued cert can run ONLY it (the SSH analogue of a pre-approved stored proc). A
# policy can require a command (forbid open shells) for a resource.
#
# The certificate principal is ALWAYS the identity Core approved (the request's --user),
# returned on redeem — never a separate caller argument, so an approved request for one
# login can never be turned into a certificate for another.
set -euo pipefail

SSH_CONF="${KALITKA_SSH_CONF:-/etc/kalitka/ssh-ca.conf}"
[ -r "$SSH_CONF" ] && . "$SSH_CONF"
AGENT_CONF="${KALITKA_CONF:-/etc/kalitka-approve.conf}"
[ -r "$AGENT_CONF" ] && . "$AGENT_CONF"

AGENT="${KALITKA_AGENT_BIN:-/usr/local/bin/kalitka-agent}"
CA_KEY="${KALITKA_SSH_CA_KEY:-/etc/kalitka/ssh_ca}"
# Conservative certificate options by default; override in the conf if you need more.
CERT_OPTS="${KALITKA_SSH_CERT_OPTS:--O clear -O permit-pty -O no-agent-forwarding -O no-port-forwarding -O no-x11-forwarding}"

die() { echo "kalitka-ssh: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }
field() { sed -n 's/.*"'"$1"'":"\([^"]*\)".*/\1/p'; }
nfield() { sed -n 's/.*"'"$1"'":\([0-9]\{1,\}\).*/\1/p'; }
arg() { local want="$1"; shift; while [ $# -gt 0 ]; do case "$1" in "--$want") printf '%s' "${2:-}"; return 0 ;; esac; shift; done; }

need "$AGENT"; need ssh-keygen

keygen() {
  if [ ! -f "$CA_KEY" ]; then
    mkdir -p "$(dirname "$CA_KEY")"
    ( umask 077; ssh-keygen -q -t ed25519 -f "$CA_KEY" -N '' -C "kalitka-ssh-ca" )
  fi
  cat "$CA_KEY.pub"
}

# Raise -> approve -> redeem for ssh:<host>; echoes "SID EXPIRES SUBJECT COMMAND". SUBJECT
# and COMMAND are the Core-approved values — the ONLY principal and force-command the signer
# is allowed to put in the cert. COMMAND (may contain spaces) is the trailing field.
_grant() {
  local host="$1" user="$2" command="${3:-}"
  local resp id state
  if [ -n "$command" ]; then
    resp="$("$AGENT" request --host "$host" --user "$user" --command "$command")" || die "gate unreachable or request refused"
  else
    resp="$("$AGENT" request --host "$host" --user "$user")" || die "gate unreachable or request refused"
  fi
  id="$(printf '%s' "$resp" | field id)"; state="$(printf '%s' "$resp" | field state)"
  [ -n "$id" ] || die "no request id (state=$state)"
  echo "kalitka-ssh: request $id for ssh:$host ($user) — waiting for approval..." >&2
  local i=0 st grant=""
  while [ "$i" -lt 100 ]; do
    sleep 3; i=$((i + 1))
    st="$("$AGENT" poll --id "$id" 2>/dev/null)" || continue
    case "$(printf '%s' "$st" | field state)" in
      approved) grant="$(printf '%s' "$st" | field grant)"; break ;;
      denied) die "denied" ;;
      gone)   die "request expired" ;;
    esac
  done
  [ -n "$grant" ] || die "timed out waiting for approval"
  local red sid exp subj
  red="$("$AGENT" redeem --grant "$grant" --agent "$(hostname -s 2>/dev/null || hostname)")" || die "grant redemption failed"
  sid="$(printf '%s' "$red" | field session_id)"
  [ -n "$sid" ] || die "grant not redeemable (already used or expired)"
  exp="$(printf '%s' "$red" | nfield expires_at)"
  subj="$(printf '%s' "$red" | field subject)"
  [ -n "$subj" ] || die "redeem returned no approved principal — refusing to sign"
  local cmd; cmd="$(printf '%s' "$red" | field command)"   # approved force-command (may be empty)
  printf '%s %s %s %s\n' "$sid" "$exp" "$subj" "$cmd"
}

# Sign a user public key against the granted session. The principal is the Core-APPROVED
# subject only (bound to the approval, never a caller argument). The cert's end is exactly
# the grant's expiry (raw epoch, no rounding), so it cannot outlive the granted authority;
# a small negative start absorbs clock skew. Key id carries the session id, so sshd's auth
# log ties straight back to the kalitka audit trail.
_sign() { # PUBKEY_FILE SID EXPIRES PRINCIPAL [COMMAND] -> writes <base>-cert.pub
  local pub="$1" sid="$2" exp="$3" principal="$4" command="${5:-}"
  [ -r "$CA_KEY" ] || die "no CA key at $CA_KEY (run 'kalitka-ssh keygen' as the CA host)"
  case "$principal" in ''|*[!A-Za-z0-9_.-]*) die "unsafe approved principal: '$principal'" ;; esac
  local now; now="$(date +%s)"
  [ -n "$exp" ] || die "grant has no expiry — refusing to sign"
  [ "$exp" -gt "$now" ] 2>/dev/null || die "grant already expired — refusing to issue a certificate"
  local start=$((now - 5))
  local -a opts=(-s "$CA_KEY" -I "kalitka:$sid" -n "$principal" -V "0x$(printf '%x' "$start"):0x$(printf '%x' "$exp")")
  # CERT_OPTS is a set of -O flags; deliberate word-split.
  # shellcheck disable=SC2206
  opts+=($CERT_OPTS)
  # The approved force-command (if any) is applied as a single, un-split argument — the
  # session can then run only this command, nothing else.
  [ -n "$command" ] && opts+=(-O "force-command=$command")
  ssh-keygen "${opts[@]}" "$pub" >&2
}

case "${1:-}" in
  keygen) keygen ;;
  ca-pubkey) [ -r "$CA_KEY.pub" ] || die "no CA key at $CA_KEY"; cat "$CA_KEY.pub" ;;

  sign)
    shift
    host="$(arg host "$@")"; [ -n "$host" ] || die "sign needs --host"
    user="$(arg user "$@")"; [ -n "$user" ] || die "sign needs --user"
    pub="$(arg pubkey "$@")"; [ -r "$pub" ] || die "sign needs a readable --pubkey"
    command="$(arg command "$@")"
    read -r sid exp principal cmd < <(_grant "$host" "$user" "$command")
    _sign "$pub" "$sid" "$exp" "$principal" "$cmd"
    "$AGENT" provisioned --session-id "$sid" >/dev/null 2>&1 || true
    cert="${pub%.pub}-cert.pub"
    echo "kalitka-ssh: issued $cert (principal: $principal${cmd:+, force-command: $cmd})" >&2
    printf '%s\n' "$cert"
    ;;

  connect)
    shift
    host="$(arg host "$@")"; [ -n "$host" ] || die "connect needs --host"
    user="$(arg user "$@")"; [ -n "$user" ] || user="$(id -un)"
    command="$(arg command "$@")"
    need ssh
    dir="$(mktemp -d "${TMPDIR:-/tmp}/kalitka-ssh.XXXXXX")"
    trap 'rm -rf "$dir"' EXIT INT TERM
    ssh-keygen -q -t ed25519 -f "$dir/id" -N '' -C "kalitka-jit"     # ephemeral, dies with $dir
    read -r sid exp principal cmd < <(_grant "$host" "$user" "$command")
    _sign "$dir/id.pub" "$sid" "$exp" "$principal" "$cmd"
    "$AGENT" provisioned --session-id "$sid" >/dev/null 2>&1 || true
    [ -n "$cmd" ] && echo "kalitka-ssh: this certificate can run only: $cmd" >&2
    echo "kalitka-ssh: connecting to ${principal}@${host} with a short-lived certificate..." >&2
    # The session lives for the ssh connection. Report the true outcome: ssh's 255 is a
    # connection/auth failure, anything else is a session that actually ran (its exit code
    # is the remote command's). The caller gets ssh's real exit code. The cert self-expires,
    # so even a missed report never leaves standing access.
    rc=0; ssh -o IdentitiesOnly=yes -i "$dir/id" -o "CertificateFile=$dir/id-cert.pub" "${principal}@${host}" || rc=$?
    if [ "$rc" -eq 255 ]; then outcome="connection-failed"; else outcome="closed"; fi
    "$AGENT" session-end --session-id "$sid" --outcome "$outcome" >/dev/null 2>&1 || true
    exit "$rc"
    ;;

  ""|-h|--help|help) sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: ${1:-} (try --help)" ;;
esac
