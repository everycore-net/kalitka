# Copy to .env and fill in. Never commit the real file.

# --- Telegram ---------------------------------------------------------------
# Bot token from BotFather.
KALITKA_BOT_TOKEN=
# Secret path the webhook posts to. Long and random, e.g. /tg/8f2c91a4b7
KALITKA_WEBHOOK_PATH=/tg/change-me
# Value Telegram must send in X-Telegram-Bot-Api-Secret-Token. Long and random.
KALITKA_WEBHOOK_SECRET=
# Your Telegram user id (not the @name). Ask @userinfobot if unsure.
KALITKA_ADMIN_ID=

# --- Sessions ---------------------------------------------------------------
# Any long random string. Changing it logs everyone out at once.
KALITKA_HMAC_SECRET=

# --- Placement --------------------------------------------------------------
# Public host of kalitka itself.
KALITKA_HOST=gate.example.com
# Parent domain for the session cookie, so one approval covers every host.
KALITKA_COOKIE_DOMAIN=.example.com

# --- Optional: Google sign-in ----------------------------------------------
# Empty client id hides the button. Authorised redirect URI at Google:
#   https://<KALITKA_HOST>/oauth2/callback
KALITKA_GOOGLE_CLIENT_ID=
KALITKA_GOOGLE_CLIENT_SECRET=

# --- Optional: arm/disarm hosts from another service -------------------------
KALITKA_INTERNAL_SECRET=
