<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Kalitka</RootNamespace>
    <AssemblyName>Kalitka</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.48.2</Version>
    <Copyright>Copyright (C) 2026 everycore</Copyright>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runtime dependencies, all opt-in and only used when a path/connection is
         configured: MaxMind.GeoIP2 for on-box geolocation (Kalitka__GeoDbPath),
         Microsoft.Data.Sqlite for the SQLite stores (Kalitka__AuditDbPath /
         Kalitka__StateDbPath), and Npgsql for the Postgres backend
         (Kalitka__PostgresConnectionString). No ORM. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <!-- WebAuthn attestation/COSE parsing. A small, stable first-party Microsoft package, not part
         of the shared framework — taken instead of a whole third-party WebAuthn stack. -->
    <PackageReference Include="System.Formats.Cbor" Version="9.0.0" />
    <!-- QR encoding for enrolment invites. A single-purpose, pure-managed MIT encoder (no native or
         image deps) — QR at link sizes needs multi-block Reed-Solomon interleaving and mask
         optimisation; unlike our JCS/WebPush formalism it has no security surface and no RFC vector to
         self-test against, so a vetted encoder is proportionate. We render the SVG ourselves. -->
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="2.0.6" />
    <!-- Primary-credential verification for the RADIUS channel: an LDAP bind to the DC. First-party
         Microsoft package; only exercised when RADIUS + LdapUrl are configured (needs libldap on
         Linux at runtime). -->
    <PackageReference Include="System.DirectoryServices.Protocols" Version="9.0.0" />
    <PackageReference Include="MaxMind.GeoIP2" Version="6.1.0" />
    <!-- No explicit SQLitePCLRaw pin on purpose: MDS 10.0.12 already resolves the native
         lib.e_sqlite3 to 2.1.12 transitively, which is OUT of GHSA-2m69-gcr7-jv3q (CVE-2025-6965,
         <= 2.1.11). What now keeps a vulnerable native SQLite out is NuGetAudit (NU1903 fails the
         build if a flagged version is ever resolved) — NOT a version here. So: do not disable
         NuGetAudit, and if NU1903 ever fires on lib.e_sqlite3, re-pin bundle_e_sqlite3 above the
         advisory range rather than silencing the audit. (We track MDS's own tested 2.1.x rather than
         forcing 2.1.13, to avoid re-introducing a mystery floor.) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kalitka.Text\Kalitka.Text.csproj" />
  </ItemGroup>

</Project>
