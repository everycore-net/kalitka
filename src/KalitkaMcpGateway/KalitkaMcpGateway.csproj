<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MCP Gateway (public / AGPL) - the guarded proxy in front of another MCP server. Every tool
    call is fingerprinted (the security boundary: a mismatch = "approved but denied", a collision
    = a bypass), classified, decided by Core, and forwarded to the real upstream at most once.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KalitkaMcpGateway</RootNamespace>
    <AssemblyName>KalitkaMcpGateway</AssemblyName>
    <Version>0.6.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Published conformance vectors: a third-party gateway must reproduce these exactly. -->
    <Content Include="conformance\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
  </ItemGroup>

</Project>
