<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    The Windows agent runs as a Windows Service. It targets net10.0-windows so it can
    reach the Windows security APIs (WindowsIdentity impersonation off a named pipe) and
    CNG (the Microsoft Platform Crypto Provider, TPM-backed). Core stays on net9: the two
    only ever meet over HTTP with the versioned kalitka-agent-sig-v1 wire scheme, so the
    runtimes need not match.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KalitkaAgent</RootNamespace>
    <AssemblyName>kalitka-agent</AssemblyName>
    <Version>0.10.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

</Project>
