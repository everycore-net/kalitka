<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KalitkaMcpGateway\KalitkaMcpGateway.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Run the published vectors from their canonical home, so the test IS the conformance check. -->
    <Content Include="..\..\src\KalitkaMcpGateway\conformance\kalitka-mcp-call-v2.json" Link="kalitka-mcp-call-v2.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\KalitkaMcpGateway\conformance\renderer-vectors.json" Link="renderer-vectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
